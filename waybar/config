{
    "layer": "top",
    "position": "top",
    "margin-top": 1,
    "margin-left": 1,
    "margin-right": 1,
    "height": 20,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "custom/weather",
        "group/music"
    ],
    "modules-center": [],
    "modules-right": [
    	"custom/discordvoice",
	"custom/tray",
	"custom/brightness",
	"custom/sound",
	"custom/bluetooth",
	"custom/wifi",
        "custom/battery",
        "custom/powermenu"
        
    ],
    // Invisible slot holder for the Quickshell Discord voice pill
    // (DiscordVoicePill.qml draws the participant avatars on top of it).
    // Leftmost of the right group; a fixed min-width in style.css keeps
    // Waybar from re-laying-out as the participant count changes.
    "custom/discordvoice": {
        "format": " ",
        "tooltip": false
    },
    // Invisible slot holder for the Quickshell system tray (TrayWidget.qml
    // draws the tray icons on top of it). A fixed min-width in style.css
    // reserves room so the Discord voice pill to its left stays clear of
    // the tray. Supersedes the §35 trayshift FIFO hack; see changes.md §36.
    "custom/tray": {
        "format": " ",
        "tooltip": false
    },
    // Invisible slot holder for the Quickshell brightness pill
    // (BrightnessPill.qml renders on top of this). See changes.md §13.
    "custom/brightness": {
        "format": " ",
        "tooltip": false
    },
    // Invisible slot holder for the Quickshell sound pill (SoundPill.qml).
    // See changes.md §14.
    "custom/sound": {
        "format": " ",
        "tooltip": false
    },
    // Invisible slot holder for the Quickshell bluetooth pill
    // (BluetoothPill.qml renders on top of this). See changes.md §15.
    "custom/bluetooth": {
        "format": " ",
        "tooltip": false
    },
    // Invisible slot holder for the Quickshell wifi pill (WifiPill.qml).
    // See changes.md §15.
    "custom/wifi": {
        "format": " ",
        "tooltip": false
    },
    // Only workspaces that actually exist are shown; sway destroys an empty
    // workspace once it loses focus and sway/scripts/workspace-manager.py
    // renumbers the survivors to 1..N. No persistent-workspaces here.
    "sway/workspaces": {
        "format": "",
        "format-icons": {},
        "all-outputs": true
    },
    // Invisible slot holder for the Quickshell battery pill
    // (BatteryPill.qml draws on top of it; BatteryPanel.qml is the
    // popover). Charge glyphs/colours now live in BatteryState.qml at
    // ~/.config/quickshell/BatteryState.qml. See changes.md §22.
    "custom/battery": {
        "format": " ",
        "tooltip": false
    },
    "custom/powermenu": {
        "format": "💢",
        "tooltip": false,
        "on-click": "qs ipc call powermenu toggle"
    },

  "custom/weather": {
    "format": "{}",
    "format-alt": "{alt}",
    "format-alt-click": "click-left",
    "interval": 3600,
    "return-type": "json",
    "exec": "~/.config/waybar/weather-waybar-module.sh",
    "exec-if": "ping openweathermap.org -c1",
    "signal": 8
  },
  // Music pill: [prev] [play/pause] [next] Title: current lyric.
  // A group (deliberately NO drawer) so hovering the pill sets the group's
  // prelight state; `#music:hover` in style.css then reveals prev/next. The
  // play/pause glyph stays visible and doubles as the playing indicator.
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "custom/music-prev",
      "custom/music-play",
      "custom/music-next",
      "custom/music-text"
    ]
  },
  "custom/music-prev": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/music-lyrics.sh prev",
    "interval": "once",
    "on-click": "mpc prev",
    "tooltip": false
  },
  "custom/music-play": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/music-lyrics.sh icon",
    "interval": 1,
    "return-type": "text",
    "on-click": "mpc toggle",
    "tooltip": false
  },
  "custom/music-next": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/music-lyrics.sh next",
    "interval": "once",
    "on-click": "mpc next",
    "tooltip": false
  },
  "custom/music-text": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/music-lyrics.sh text",
    "interval": 1,
    "return-type": "text",
    "on-click": "mpc toggle",
    "tooltip": false
  }
}

#!/usr/bin/env bash
# Simple battery alert - notifies at 15% and 5% (replaces the missing
# battery-alert file from the New Wave repo, see ~/changes.md)

THRESHOLDS="15 5"

notify() {
    if command -v dunstify >/dev/null 2>&1; then
        dunstify -u "${2:-normal}" -a "Battery" "Battery ${3}" "$1"
    else
        notify-send -u "${2:-normal}" "Battery ${3}" "$1"
    fi
}

while true; do
    for bat in /sys/class/power_supply/BAT*; do
        [ -e "$bat/capacity" ] || continue
        cap=$(cat "$bat/capacity" 2>/dev/null) || continue
        status=$(cat "$bat/status" 2>/dev/null)
        [ "$status" = "Charging" ] && continue
        for t in $THRESHOLDS; do
            state_file="/tmp/battery-alert-$(basename "$bat")-$t"
            if [ "$cap" -le "$t" ]; then
                if [ ! -f "$state_file" ]; then
                    urgency="normal"
                    [ "$t" -le 5 ] && urgency="critical"
                    notify "Battery at ${cap}% — please plug in." "$urgency" "Low"
                    touch "$state_file"
                fi
            else
                rm -f "$state_file"
            fi
        done
    done
    sleep 60
done

#!/usr/bin/env bash
# power-mode — Low Power Mode for the AMD Ryzen 3500U.
#
#   on            tier 1: boost off, every core capped to 1.4 GHz
#   off           everything off: freq cap off + APU power limits restored
#   toggle        flip tier 1 (turning it off also drops tier 2)
#   max           tier 2: tier 1 plus APU STAPM/PPT caps via ryzenadj
#   limit-on      tier 2 only (re-apply the ryzenadj caps, tier 1 untouched)
#   limit-off     restore the APU limits captured when tier 2 was enabled
#   status        print "on" or "off" for tier 1
#   limit-status  print "on" or "off" for tier 2
#
# Tier 2 caps the whole APU (CPU + Vega iGPU) at 6/8/10 W
# (STAPM / PPT slow / PPT fast). The stock limits are captured to
# /run/power-mode/ryzenadj-defaults the first time tier 2 is enabled and
# restored on demand. Both the file and the limits themselves are volatile,
# so a reboot resets everything to firmware defaults.
#
# Driven by the Quickshell battery panel (BatteryPanel.qml) through
# passwordless sudo. See changes.md §25/§26.

set -euo pipefail

CPUFREQ=/sys/devices/system/cpu/cpufreq
BOOST=$CPUFREQ/boost
LOW_FREQ=1400000
GOVERNOR=schedutil

STATE_DIR=/run/power-mode
STATE=$STATE_DIR/ryzenadj-defaults
LOW_STAPM=6000   # mW — sustained package power cap (tier 2)
LOW_SLOW=8000    # mW — 5s window
LOW_FAST=10000   # mW — instant burst

policies() {
    ls -d "$CPUFREQ"/policy* 2>/dev/null || true
}

# Best effort: a machine without a given knob should not make the whole
# toggle fail halfway through.
write() {
    echo "$1" > "$2" 2>/dev/null || true
}

low_on() {
    write 0 "$BOOST"
    local p
    for p in $(policies); do
        write "$LOW_FREQ" "$p/scaling_max_freq"
        write "$GOVERNOR" "$p/scaling_governor"
    done
}

low_off() {
    local p
    for p in $(policies); do
        write "$(cat "$p/cpuinfo_max_freq")" "$p/scaling_max_freq"
        write "$GOVERNOR" "$p/scaling_governor"
    done
    write 1 "$BOOST"
}

is_on() {
    local boost=1 max= first
    [ -r "$BOOST" ] && boost=$(cat "$BOOST")
    first=$(policies | head -n 1)
    if [ -n "$first" ] && [ -r "$first/scaling_max_freq" ]; then
        max=$(cat "$first/scaling_max_freq")
    fi
    [ "$boost" = "0" ] && [ -n "$max" ] && [ "$max" -le "$LOW_FREQ" ]
}

# ---------- tier 2: ryzenadj APU power limits ----------

capture_defaults() {
    local cfg
    # Values in the PM table are watts; ryzenadj takes milliwatts.
    cfg=$(ryzenadj -i 2>/dev/null | awk -F'|' '
        $2 ~ /STAPM LIMIT/    {gsub(/ /,"",$3); stapm=$3+0}
        $2 ~ /PPT LIMIT SLOW/ {gsub(/ /,"",$3); slow=$3+0}
        $2 ~ /PPT LIMIT FAST/ {gsub(/ /,"",$3); fast=$3+0}
        END {
            if (stapm > 0 && slow > 0 && fast > 0)
                printf "%d %d %d\n", int(stapm*1000+0.5), int(slow*1000+0.5), int(fast*1000+0.5)
        }' || true)
    [ -n "$cfg" ] || return 1
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$cfg" > "$STATE"
}

limit_on() {
    command -v ryzenadj >/dev/null 2>&1 || {
        echo "ryzenadj is not installed" >&2
        exit 1
    }
    if [ ! -f "$STATE" ]; then
        capture_defaults || {
            echo "could not read the stock APU limits (ryzen_smu module loaded?)" >&2
            exit 1
        }
    fi
    ryzenadj --stapm-limit="$LOW_STAPM" --slow-limit="$LOW_SLOW" --fast-limit="$LOW_FAST" >/dev/null
}

limit_off() {
    command -v ryzenadj >/dev/null 2>&1 || return 0
    [ -f "$STATE" ] || return 0
    local stapm slow fast
    read -r stapm slow fast < "$STATE"
    ryzenadj --stapm-limit="$stapm" --slow-limit="$slow" --fast-limit="$fast" >/dev/null || true
    rm -f "$STATE"
}

limit_is_on() {
    [ -f "$STATE" ]
}

case "${1:-status}" in
    on)           low_on ;;
    off)          low_off; limit_off ;;
    toggle)       if is_on; then low_off; limit_off; else low_on; fi ;;
    max)          low_on; limit_on ;;
    limit-on)     limit_on ;;
    limit-off)    limit_off ;;
    status)       if is_on; then echo on; else echo off; fi ;;
    limit-status) if limit_is_on; then echo on; else echo off; fi ;;
    *)
        echo "usage: power-mode {on|off|toggle|max|limit-on|limit-off|status|limit-status}" >&2
        exit 2
        ;;
esac

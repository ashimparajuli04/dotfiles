#!/usr/bin/env bash
#
# quickshell-watchdog — relaunch Quickshell when it wedges.
#
# Quickshell (0.3.2 + Qt 6.12 + Mesa RADV) can deadlock in the Wayland/Mesa
# present path:
#   QWaylandWindow::applyConfigure -> sendExposeEvent -> QQuickWindow sync
#   ... waiting on the QSGRenderThread, which is stuck in
#   QRhi::endFrame -> libvulkan_radeon -> wl_display_dispatch_queue.
# Both threads wait on each other and the process never recovers: its IPC
# stops answering and every bar pill / notification freezes (quickshell
# issue #919). A wedged instance cannot rescue itself, so this supervisor
# probes the IPC and, after a few consecutive timeouts, kills and relaunches
# Quickshell — turning a dead bar into a ~2s blip.
#
# The Vulkan RHI was the reliable trigger here, so we launch with OpenGL
# instead (see launch() below); the watchdog is the belt-and-braces net for
# any remaining configure-path wedge.
#
# This is the single owner of the Quickshell launch (sway execs this instead
# of `quickshell` directly). Single-instance via a pidfile.
#
# It also owns the *sway socket* the shell talks to. Quickshell drives sway by
# shelling out to `swaymsg`, which resolves the compositor from SWAYSOCK /
# I3SOCK. This watchdog starts at login but gets orphaned (reparented to init)
# when sway exits, so it — and every Quickshell it relaunches — can keep a
# socket path that is already dead. Every `swaymsg` inside Quickshell then
# fails silently: the display wizard sees no outputs, the bar never hides over
# fullscreen, workspaces/logout break. To prevent that we re-resolve the live
# socket every pass (live_sock), recycle a Quickshell bound to a stale one, and
# step aside when sway is gone so the next session can take over.
#
# Registered in setup.sh -> EXTRA_LINKS as bin/quickshell-watchdog |
# ~/.local/bin/quickshell-watchdog.

set -u

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PIDFILE="$RUNTIME/quickshell-watchdog.pid"
LOG="quickshell-watchdog"

# Probe cadence. MAX_FAILS * INTERVAL gives Quickshell ~15s to come up after a
# (re)launch before we consider it wedged.
INTERVAL=5
PROBE_TIMEOUT=5
MAX_FAILS=3
SETTLE=10

# SWAYSOCK recorded in a process's environment (empty if unreadable/unset).
sock_of_pid() {
    tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null \
        | sed -n 's/^SWAYSOCK=//p' | head -n1
}

# Path of the *live* sway socket. Never trust the inherited SWAYSOCK/I3SOCK —
# they may point at a sway that has since exited. Probe the candidates and keep
# the one sway actually answers on. Non-zero = no sway running.
live_sock() {
    local f
    for f in "$RUNTIME"/sway-ipc."$(id -u)".*.sock; do
        [ -S "$f" ] || continue
        if SWAYSOCK="$f" I3SOCK="$f" swaymsg -t get_version >/dev/null 2>&1; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    return 1
}

# QSG_RHI_BACKEND=opengl, NOT vulkan: on this stack the Vulkan RHI deadlocks in
# the Wayland/Mesa present path and wedges the whole shell within ~30s
# (quickshell issue #919; reproduced here). OpenGL doesn't take that path and
# survived a heavy panel-churn soak. MALLOC_CONF=retain:false trims freed pages.
# --no-duplicate avoids racing an already-running instance.
launch() {
    # Reap any `mpc idleloop` orphaned by a hard-killed previous instance
    # (Quickshell's MusicState event source). launch() only runs when no
    # Quickshell is alive, so any idleloop present here is stale.
    pkill -f 'mpc idleloop' 2>/dev/null || true
    # Same for DiscordVoice.qml's discord-ipc presence watcher: a hard-killed
    # Quickshell (SIGKILL from this watchdog) leaves its bash loop reparented and
    # still polling. One bash is harmless, but they must not accumulate across
    # wedge restarts.
    pkill -f 'discord-ipc-' 2>/dev/null || true
    # And the bridge itself: it detaches from a killed Quickshell and keeps
    # running forever (it only reports Discord's state, it never exits), so a
    # stale one would defeat the "no python while Discord is closed" gate. The
    # freshly launched Quickshell's gate will start a new one (if Discord is up)
    # and re-authenticate from the cached token.
    pkill -f 'discord_bridge.py' 2>/dev/null || true
    env QSG_RHI_BACKEND=opengl MALLOC_CONF=retain:false \
        quickshell --no-duplicate >/dev/null 2>&1 &
}

# Single instance via pidfile. (Not flock: a lock fd would be inherited by the
# launched Quickshell and its children, so it would stay held — and block a new
# watchdog — even after this process exited.)
#
# A plain "is the pid alive" check is not enough: an owner orphaned across a
# sway restart is alive but points at a dead socket, so it can never drive the
# current session and would block this session's exec line forever. Only defer
# to an owner whose socket still answers; otherwise take over.
if [ -f "$PIDFILE" ]; then
    old="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
        old_sock="$(sock_of_pid "$old")"
        if [ -n "$old_sock" ] \
            && SWAYSOCK="$old_sock" I3SOCK="$old_sock" swaymsg -t get_version >/dev/null 2>&1; then
            exit 0
        fi
        kill "$old" 2>/dev/null || true
    fi
fi
printf '%s\n' "$$" > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

fails=0
while true; do
    # Re-resolve the live socket every pass: a sway restart swaps the path, and
    # this watchdog can outlive one. If sway is gone this session is over —
    # release the pidfile so the next session's exec line can own the watchdog.
    sock="$(live_sock)" || { rm -f "$PIDFILE"; exit 0; }
    export SWAYSOCK="$sock" I3SOCK="$sock"

    # Recycle a running Quickshell that was started against a different (dead)
    # socket — inherited from a stale owner or from an earlier sway — so every
    # `swaymsg` inside it targets the live compositor.
    qs_pid="$(pgrep -x quickshell 2>/dev/null | head -n1)"
    if [ -n "$qs_pid" ]; then
        qs_sock="$(sock_of_pid "$qs_pid")"
        if [ -n "$qs_sock" ] && [ "$qs_sock" != "$sock" ]; then
            logger -t "$LOG" "quickshell on stale sway socket; restarting" 2>/dev/null || true
            pkill -9 -x quickshell 2>/dev/null || true
            sleep 1
        fi
    fi

    if ! pgrep -x quickshell >/dev/null 2>&1; then
        launch
        fails=0
        sleep "$SETTLE"
        continue
    fi

    if timeout "$PROBE_TIMEOUT" qs ipc show >/dev/null 2>&1; then
        fails=0
    else
        fails=$((fails + 1))
        if [ "$fails" -ge "$MAX_FAILS" ]; then
            logger -t "$LOG" "quickshell IPC not responding; restarting" 2>/dev/null || true
            pkill -9 -x quickshell 2>/dev/null || true
            sleep 1
            launch
            fails=0
            sleep "$SETTLE"
            continue
        fi
    fi

    sleep "$INTERVAL"
done

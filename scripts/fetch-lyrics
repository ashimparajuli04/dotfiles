#!/home/ashim/Programming/dotfiles/scripts/.venv/bin/python3
"""
Fetch synced (.lrc) lyrics for the MPD library from LRCLIB.
Generates romaji for Japanese songs.

Usage:
    fetch-lyrics              # Fetch missing lyrics + generate romaji
    fetch-lyrics --force      # Re-fetch all lyrics
    fetch-lyrics --romaji-only # Only convert existing to romaji
    fetch-lyrics --current    # Only current song
    fetch-lyrics --dry-run    # Show what would be done
"""

import argparse
import json
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

# === Configuration ===
MUSIC_DIR = Path.home() / "Music"
LYRICS_DIR = Path.home() / ".local/share/lyrics"
LRCLIB_API = "https://lrclib.net/api"
USER_AGENT = "fetch-lyrics/1.0"
SLEEP_BETWEEN = 0.6

# Romanized -> native Japanese title mappings
TITLE_MAPPINGS = {
    "ohayouopatsu": "おはようオーパーツ",
    "that girl i can't stop thinking about": "気になるあの娘",
    "jinkou eisei": "人工衛星",
    "ao 100 shoku": "青100色",
    "sign wa b": "サインはB",
}

# Japanese-specific Unicode ranges (Hiragana + Katakana only, not Kanji)
# This avoids false positives on Chinese/Korean songs that use shared CJK characters
JP_CHARS = re.compile(r'[\u3040-\u309F\u30A0-\u30FF]')


def is_japanese(text: str) -> bool:
    """Check if text contains Japanese characters."""
    return bool(JP_CHARS.search(text))


def normalize_title(title: str) -> str:
    """Normalize title for searching."""
    # Remove parenthetical content
    t = re.sub(r'\s*\([^)]*\)', '', title)
    # Remove common suffixes
    t = re.sub(r'\s*-\s*(From|feat|ft|with|live|acoustic|instrumental|remix).*$', '', t, flags=re.I)
    # Normalize whitespace
    t = ' '.join(t.split()).strip()
    # Normalize apostrophes (curly -> straight) and remove trailing dash
    t = t.replace('\u2019', "'").replace('\u2018', "'")
    t = t.rstrip('-').strip()
    return t


def get_duration(filepath: Path) -> float | None:
    """Get audio file duration in seconds."""
    try:
        result = subprocess.run(
            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
             '-of', 'default=noprint_wrappers=1:nokey=1', str(filepath)],
            capture_output=True, text=True, timeout=5
        )
        return float(result.stdout.strip())
    except (subprocess.TimeoutExpired, ValueError, FileNotFoundError):
        return None


def lrclib_search(query: str) -> list:
    """Search LRCLIB API."""
    try:
        url = f"{LRCLIB_API}/search?q={urllib.parse.quote(query)}"
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except Exception:
        return []


def lrclib_get(lrc_id: int) -> dict | None:
    """Get lyrics by LRCLIB ID."""
    try:
        url = f"{LRCLIB_API}/get/{lrc_id}"
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except Exception:
        return None


def find_match(title: str, artist: str, duration: float | None = None) -> dict | None:
    """Find best LRCLIB match using multiple search strategies."""
    queries = []

    # Check for known romanized title mapping
    normalized = normalize_title(title).lower()
    mapped = TITLE_MAPPINGS.get(normalized)
    if mapped:
        queries.append(f"{artist} - {mapped}" if artist else mapped)
        queries.append(mapped)

    # Standard queries
    if artist and title:
        queries.append(f"{artist} - {title}")
    queries.append(title)

    # Normalized title
    norm = normalize_title(title)
    if norm != title:
        queries.append(norm)

    for query in queries:
        results = lrclib_search(query)
        if not results:
            continue

        # Filter for synced lyrics
        synced = [r for r in results if r.get('syncedLyrics')]
        if not synced:
            continue

        # Pick best by duration match
        if duration:
            best = min(synced, key=lambda r: abs((r.get('duration') or 0) - duration))
            if abs((best.get('duration') or 0) - duration) < 10:
                return best

        return synced[0]

    return None


def to_romaji(text: str) -> str:
    """Convert Japanese text to romaji using pykakasi."""
    import warnings
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", DeprecationWarning)
        import pykakasi
        kakasi = pykakasi.kakasi()
        kakasi.setMode("H", "a")  # Hiragana -> ascii
        kakasi.setMode("K", "a")  # Katakana -> ascii
        kakasi.setMode("J", "a")  # Kanji -> ascii
        kakasi.setMode("r", "Hepburn")
        conv = kakasi.getConverter()
        return conv.do(text)


def convert_lrc_to_romaji(lrc_content: str) -> str:
    """Convert LRC content to romaji, preserving timestamps."""
    lines = lrc_content.split('\n')
    result = []

    for line in lines:
        # Match LRC timestamp pattern (possibly multiple)
        match = re.match(r'((?:\[[\d:.]+\])+)(.*)', line)
        if match:
            timestamps, text = match.groups()
            if is_japanese(text):
                text = to_romaji(text)
            result.append(f"{timestamps}{text}")
        else:
            result.append(line)

    return '\n'.join(result)


def get_songs() -> list[tuple[Path, str, str]]:
    """Get all songs from music directory."""
    songs = []
    for ext in ('*.flac', '*.mp3', '*.m4a', '*.opus', '*.ogg'):
        for f in MUSIC_DIR.glob(ext):
            stem = f.stem
            if ' - ' in stem:
                artist, title = stem.split(' - ', 1)
            else:
                artist, title = '', stem
            songs.append((f, artist, title))
    return songs


def process_song(filepath: Path, artist: str, title: str, force: bool = False, dry_run: bool = False) -> str:
    """Process a single song: fetch lyrics and/or convert to romaji."""
    base = filepath.stem
    target = LYRICS_DIR / f"{base}.lrc"

    # Check if already processed
    if target.exists() and not force:
        content = target.read_text()
        if not is_japanese(content):
            return "ok"
        # Convert existing Japanese lyrics to romaji
        if dry_run:
            return "romaji"
        romaji = convert_lrc_to_romaji(content)
        target.write_text(romaji)
        return "romaji"

    # Fetch from LRCLIB
    if dry_run:
        return "fetch"

    duration = get_duration(filepath)
    match = find_match(title, artist, duration)

    if not match:
        return "missing"

    data = lrclib_get(match['id'])
    if not data or not data.get('syncedLyrics'):
        return "missing"

    lrc_content = data['syncedLyrics']

    # Convert to romaji if Japanese
    if is_japanese(lrc_content):
        lrc_content = convert_lrc_to_romaji(lrc_content)

    LYRICS_DIR.mkdir(parents=True, exist_ok=True)
    target.write_text(lrc_content)
    return "fetched"


def main():
    parser = argparse.ArgumentParser(description="Fetch synced lyrics from LRCLIB")
    parser.add_argument("--force", action="store_true", help="Re-fetch all lyrics")
    parser.add_argument("--romaji-only", action="store_true", help="Only convert existing to romaji")
    parser.add_argument("--current", action="store_true", help="Only current song")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done")
    args = parser.parse_args()

    if args.current:
        # Get current song from MPD
        try:
            result = subprocess.run(
                ['mpc', 'current', '-f', '%file%\t%artist%\t%title%'],
                capture_output=True, text=True, timeout=5
            )
            parts = result.stdout.strip().split('\t')
            if len(parts) >= 3:
                filepath = MUSIC_DIR / parts[0]
                songs = [(filepath, parts[1], parts[2])]
            else:
                songs = []
        except Exception:
            songs = []
    else:
        songs = get_songs()

    total = len(songs)
    if total == 0:
        print("No songs found.")
        return

    print(f"Processing {total} songs...")

    fetched = 0
    romaji = 0
    ok = 0
    missing = 0

    for i, (filepath, artist, title) in enumerate(songs, 1):
        result = process_song(filepath, artist, title, force=args.force, dry_run=args.dry_run)

        if result == "fetched":
            fetched += 1
            print(f"[{i}/{total}] fetched: {artist} - {title}")
        elif result == "romaji":
            romaji += 1
            print(f"[{i}/{total}] romaji: {artist} - {title}")
        elif result == "ok":
            ok += 1
        elif result == "missing":
            missing += 1
            print(f"[{i}/{total}] missing: {artist} - {title}")

        if i < total:
            time.sleep(SLEEP_BETWEEN)

    print(f"\nDone: {fetched} fetched, {romaji} romaji, {ok} ok, {missing} missing")


if __name__ == "__main__":
    main()

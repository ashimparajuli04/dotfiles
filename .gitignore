# --- runtime state (regenerated by the apps) ---
mpd/mpd.db
mpd/state
systemd/user/*.wants/

# --- secrets ---
vdirsyncer/*-password
mpd-lyricsd/config.toml

# --- local venv for the lyrics scripts ---
scripts/.venv/

# --- Apple-licensed fonts (installed locally, never redistributed) ---
fonts/SFPro/

# --- Python bytecode ---
__pycache__/
*.pyc

# iCloud sync: calendars (CalDAV) + contacts (CardDAV)
# Password: app-specific password from account.apple.com, stored in
# ~/.config/vdirsyncer/icloud-password (chmod 600).
#
# Run manually:  vdirsyncer sync
# Automatic:     systemd --user timer "vdirsyncer.timer" (hourly)

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair icloud_calendars]
a = "icloud_calendars_remote"
b = "icloud_calendars_local"
# Only the "work" calendar exists on this account; skip "Reminders".
collections = ["work"]
conflict_resolution = "a wins"
metadata = ["color", "displayname"]

[storage icloud_calendars_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
username = "ashimparajuli799@gmail.com"
password.fetch = ["command", "cat", "/home/ashim/.config/vdirsyncer/icloud-password"]

[storage icloud_calendars_local]
type = "filesystem"
path = "~/.calendars/icloud/"
fileext = ".ics"

[pair icloud_contacts]
a = "icloud_contacts_remote"
b = "icloud_contacts_local"
collections = ["card"]
conflict_resolution = "a wins"

[storage icloud_contacts_remote]
type = "carddav"
url = "https://contacts.icloud.com/"
username = "ashimparajuli799@gmail.com"
password.fetch = ["command", "cat", "/home/ashim/.config/vdirsyncer/icloud-password"]

[storage icloud_contacts_local]
type = "filesystem"
path = "~/.contacts/icloud/"
fileext = ".vcf"

# ---------------- Google Calendar (main data source) ----------------

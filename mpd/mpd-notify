#!/usr/bin/env bash
# notify when mpd music changed

COVER="/tmp/cover.png"
# mpd music directory
MUSIC_DIR="$HOME/Music"
# if cover not found in metadata use this instead
BACKUP_COVER="/tmp/cover.jpg"

get_cover() {
	ffmpeg -i "${MUSIC_DIR}"/"$(mpc current -f %file%)" "${COVER}" -y &> /dev/null
	STATUS=$?

	# Check if the file has a embbeded album art
	if [ "$STATUS" -eq 0 ];then
		echo "$COVER"
	else
		echo "$BACKUP_COVER"
	fi
}

while "true"; do
    status="`mpc status`"
    if [[ ${status} == *"[playing]"* ]]; then
        cover=$(get_cover)
        # notify-send (libnotify), NOT dunstify: Quickshell owns
        # org.freedesktop.Notifications now, so no dunst needed. The
        # image-path hint is what Quickshell reads for the album thumbnail.
        notify-send -a Music -r 27072 -t 2000 \
            -i "$cover" -h "string:image-path:$cover" \
            "$(mpc --format '%title%-%artist%' current)"
    fi
    mpc current --wait > /dev/null
done

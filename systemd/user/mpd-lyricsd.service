[Unit]
Description=MPD lyrics daemon (feeds the music widget's plain-text lyrics fallback)
Documentation=file:///home/ashim/.config/mpd-lyricsd/config.toml
Wants=mpd.service
After=mpd.service

[Service]
ExecStart=/home/ashim/.local/bin/mpd-lyricsd
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

### Touchpad gestures
# 3-finger horizontal swipe: right = previous (left) workspace,
# left = next (right) workspace; both created on demand like pressing Mod+N.
# No previous workspace exists on workspace 1, so that swipe is ignored there.
bindgesture swipe:3:left exec ~/.config/sway/scripts/gesture-workspace.py right
bindgesture swipe:3:right exec ~/.config/sway/scripts/gesture-workspace.py left

# 4-finger swipe: move the focused container; if it can't move (layout
# edge), it is carried to the adjacent workspace instead
bindgesture swipe:4:left exec ~/.config/sway/scripts/gesture-move.py left
bindgesture swipe:4:right exec ~/.config/sway/scripts/gesture-move.py right
bindgesture swipe:4:up exec ~/.config/sway/scripts/gesture-move.py up
bindgesture swipe:4:down exec ~/.config/sway/scripts/gesture-move.py down

include /etc/sway/config.d/*

# NEW WAVE ---------------------------------------------------------------------
# Ported from https://github.com/LoneWolf4713/new-wave (see /home/ashim/changes.md)

# Touchpad Click --
input "type:touchpad" {
    dwt enabled
    tap enabled
    middle_emulation enabled
    scroll_method two_finger
    natural_scroll enabled
}

# Right Alt as an extra $mod key:
# maps right Alt to Super (Mod4) through the custom XKB option defined in
# ~/.config/xkb/symbols/custom (+ ~/.config/xkb/rules/evdev). Left Alt and the
# Win keys keep their normal behavior; the Logo key still works as $mod too.
input "type:keyboard" {
    xkb_options custom:ralt_super
}

# Gaps And No Borders:
# NOTE (sway 1.12): "inner" spaces each window (including workspace edges),
# "outer" is ADDITIONAL workspace spacing -> edge gap = inner + outer.
# Tuned per user request: 6px edges / 6px between windows, top gap matched
# to the Waybar pills (margin-top 1 + 5px pill margin). See ~/changes.md.
gaps inner 6
gaps outer 0
default_border none
default_floating_border none
font pango:monospace 1
titlebar_padding 1
titlebar_border_thickness 0

# Rofi Menus:
bindsym XF86PowerOff exec qs ipc call powermenu toggle

# GTK Theme:
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema gtk-theme 'Nightfox-Dusk-B'
    gsettings set $gnome-schema icon-theme 'Flat-Remix-Blue-Dark'
    gsettings set $gnome-schema cursor-theme 'Bibata-Modern-Ice'
    gsettings set $gnome-schema font-name 'SF Pro Display'
}

# MPD / Music Setup:
# mpd is started by the systemd user service 'mpd.service' (systemctl --user enable --now mpd)
# exec --no-startup-id mpd
exec --no-startup-id bash /home/ashim/.config/mpd/mpd-notify
# mpd-lyricsd is managed by the systemd user service 'mpd-lyricsd.service' (auto-restarts)
assign [app_id="Spotify"] workspace number 4
# rmpc is no longer auto-started or pinned to workspace 3 — the Quickshell
# music widget (cover-art click → library/queue) replaces it. rmpc stays
# installed; launch it manually from a terminal if you ever want the TUI.

# Notifications:
exec --no-startup-id dunst

# Focus apps' windows when they request attention (e.g. clicking Discord's tray icon):
exec --no-startup-id bash /home/ashim/.config/sway/scripts/urgent-focus.sh

# Keep workspace numbers contiguous: sway destroys an empty, unfocused
# workspace but never renumbers the rest, so after workspace 1 empties you are
# left on "2". This helper renames the survivors to 1..N (see changes.md §33).
exec --no-startup-id ~/.config/sway/scripts/workspace-compact.py

# Waybar (replaces the built-in swaybar):
# wait for MPD first, so waybar's 'mpd' module doesn't get stuck disconnected
exec --no-startup-id sh -c 'for i in $(seq 1 50); do mpc status >/dev/null 2>&1 && break; sleep 0.2; done; exec waybar'

# Battery Alert:
exec --no-startup-id /home/ashim/.config/battery-alert/battery-alert

# Quickshell (Bluetooth / Wi-Fi / Sound / Power popovers, toggled from the Waybar icons):
exec --no-startup-id quickshell --no-duplicate

# Brightness CTRL (F2/F3, in addition to the Fn keys above):
bindsym F2 exec brightnessctl set 5%-
bindsym F3 exec brightnessctl set 5%+
